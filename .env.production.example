# ==============================================================================
# TeamFlow Sports — production .env (для сервера, docker-compose).
#
# Скопируйте этот файл на сервере в `.env` (именно `.env`, без .example —
# docker-compose ищет файл с этим именем автоматически) и заполните все
# значения. Этот файл НИКОГДА не коммитится в git (см. .gitignore) и
# полностью отдельный от вашего локального .env / .env.sandbox — сгенерируйте
# для сервера новые, свежие секреты, не копируйте значения с локальной машины.
# ==============================================================================

# --- Домен и Postgres — читаются docker-compose.yml для подстановки -----------
# Домен, который вы направили на сервер (см. гайд по деплою, шаг про DNS).
DOMAIN=example.com

# Логин/пароль/имя базы для контейнера postgres. Пароль — сгенерируйте
# длинную случайную строку (например: openssl rand -hex 24), не используйте
# простой пароль.
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=teamflow

# --- Режим запуска -------------------------------------------------------------
APP_MODE=main

# --- Telegram Bot ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Публичный URL фронтенда = https://<ваш DOMAIN выше>
MINI_APP_URL=https://example.com

# --- PostgreSQL -------------------------------------------------------------------
# DATABASE_URL здесь можно не трогать — docker-compose.yml собирает его сам
# из POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB выше и переопределяет для
# backend/bot контейнеров. Оставлено для полноты, если запустите backend
# без Docker.
DATABASE_URL=postgresql://teamflow:teamflow@postgres:5432/teamflow
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# --- JWT --------------------------------------------------------------------------
# Сгенерируйте новый секрет: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# --- CORS ---------------------------------------------------------------------------
# Тот же домен, что в DOMAIN/MINI_APP_URL, с https://
CORS_ORIGINS=https://example.com

# --- Backend HTTP сервер -------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Dev-логин без Telegram ------------------------------------------------------------
# ДОЛЖНО оставаться false здесь. true снимает проверку подписи Telegram
# initData полностью — это только для локальной машины разработчика,
# см. docs/dev-notes.md.
DEV_AUTH_ENABLED=false

# --- Администраторы ------------------------------------------------------------------
ADMIN_TELEGRAM_IDS=

# --- Yandex AI Studio (опционально) --------------------------------------------------
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# --- Яндекс Диск (опционально, но нужен для загрузки фото/видео) ---------------------
YANDEX_DISK_OAUTH_TOKEN=
YANDEX_DISK_ROOT_FOLDER=/TeamFlow

# --- Загрузка файлов -------------------------------------------------------------------
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=200
UPLOAD_CHUNK_SIZE_KB=512

# --- Таймауты и лимиты -------------------------------------------------------------------
HTTP_CLIENT_TIMEOUT_SECONDS=15
RATE_LIMIT_PER_MINUTE=300

# --- Приглашения в команду -----------------------------------------------------------------
INVITE_EXPIRATION_HOURS=24

# --- Фоновые задачи --------------------------------------------------------------------------
BACKGROUND_TASK_INTERVAL_SECONDS=30
SOFT_DELETE_RETENTION_DAYS=30

# --- Уведомления -----------------------------------------------------------------------------
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY_SECONDS=60
TASK_DEADLINE_REMINDER_HOURS_BEFORE=24
