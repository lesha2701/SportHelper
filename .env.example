# ==============================================================================
# TeamFlow Sports — пример конфигурации.
# Скопируйте в .env (для основного бота) и/или .env.sandbox (для песочницы).
# Реальные .env* файлы никогда не коммитятся (см. .gitignore).
# ==============================================================================

# --- Режим запуска -----------------------------------------------------------
# sandbox — тестовый инстанс, main — боевой. Влияет на корневую папку Яндекс.Диска
# и используется в логах/уведомлениях для различения инстансов.
APP_MODE=sandbox

# --- Telegram Bot (используется с итерации 1) --------------------------------
TELEGRAM_BOT_TOKEN=
# Username бота без @ (используется с итерации 3 для ссылок-приглашений в команду)
TELEGRAM_BOT_USERNAME=
# Публичный URL, на котором развёрнут frontend (Telegram Mini App)
MINI_APP_URL=https://example.com

# --- PostgreSQL (используется с итерации 1) -----------------------------------
# Формат: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://teamflow:teamflow@localhost:5432/teamflow_sandbox
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# --- JWT (используется с итерации 1) ------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# --- CORS (используется с итерации 1) -----------------------------------------
# Список источников через запятую, которым разрешено обращаться к API
CORS_ORIGINS=http://localhost:5173

# --- Backend HTTP сервер -------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Dev-логин без Telegram (см. docs/dev-notes.md) ----------------------------
# Включает POST /api/auth/dev-login — вход без подписи Telegram initData,
# нужен только чтобы открывать Mini App напрямую в браузере при локальной
# разработке. По умолчанию выключено. НИКОГДА не ставьте true на
# песочнице/боевом сервере — это полностью снимает проверку подлинности входа.
DEV_AUTH_ENABLED=false

# --- Администраторы (используется с итерации 1 для проверки в боте; сами
# команды /admin, /stats и т.д. появятся в итерации 13) ------------------------
# Telegram ID через запятую
ADMIN_TELEGRAM_IDS=

# --- Yandex AI Studio (используется с итерации 14) -----------------------------
# OpenAI-совместимый эндпоинт Yandex Cloud (chat/completions).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# --- Яндекс Диск (используется с итерации 4) ------------------------------------
YANDEX_DISK_OAUTH_TOKEN=
YANDEX_DISK_ROOT_FOLDER=/TeamFlow

# --- Загрузка файлов (используется с итерации 4) --------------------------------
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=200
UPLOAD_CHUNK_SIZE_KB=512

# --- Таймауты и лимиты (используется по мере необходимости) --------------------
HTTP_CLIENT_TIMEOUT_SECONDS=15
RATE_LIMIT_PER_MINUTE=300

# --- Приглашения в команду (используется с итерации 3) --------------------------
# Срок действия ссылки-приглашения в команду, часов
INVITE_EXPIRATION_HOURS=24

# --- Фоновые задачи (используется с итерации 10) --------------------------------
BACKGROUND_TASK_INTERVAL_SECONDS=30
SOFT_DELETE_RETENTION_DAYS=30

# --- Уведомления (используется с итерации 10) -----------------------------------
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY_SECONDS=60
# За сколько часов до дедлайна задания напомнить игроку
TASK_DEADLINE_REMINDER_HOURS_BEFORE=24

# --- Feature flags (расширяются по мере разработки) ------------------------------
FEATURE_AI_ENABLED=false
